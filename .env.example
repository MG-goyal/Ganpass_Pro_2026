# GEMINI_API_KEY: Required for server-side Gemini AI Darshan Assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection URI for Python FastAPI production backend.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ganpass?retryWrites=true&w=majority"

# DATABASE_NAME: Target MongoDB database name.
DATABASE_NAME="ganpass"

# JWT_SECRET: Secret key for signing devotee and admin authentication tokens.
JWT_SECRET="ganpass_2026_production_secret_key_mumbai_sarvajanik_utsav_samiti_32"

# CHECKIN_RADIUS_METERS: Maximum distance for GPS Haversine verification (defaults to 150m).
CHECKIN_RADIUS_METERS=150

# CORS_ORIGINS: Comma-separated list of allowed origins.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://ais-dev-f2jyhltvkhdmrmt53kqv3m-810700504339.asia-southeast1.run.app,https://ais-pre-f2jyhltvkhdmrmt53kqv3m-810700504339.asia-southeast1.run.app"

# Optional external API URL for client if hosting Python backend separately:
VITE_API_URL="/api"
